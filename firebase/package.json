{
  "name": "stocksense-firebase",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase configuration (security rules, hosting) and rules tests for the StockSense Firebase edition",
  "scripts": {
    "emulators": "firebase emulators:start --only auth,firestore --project demo-stocksense",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-stocksense \"tsx --test tests/*.test.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:hosting": "firebase deploy --only hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.3.0",
    "firebase-tools": "^15.36.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
