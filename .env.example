# ---------------------------------------------------------------------------
# StockSense - Docker Compose configuration
# Copy to `.env` (same folder as docker-compose.yml) and change the values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=stocksense
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT signing secret: at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=8h

# Public URL(s) of the web UI allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:8080

# Host ports
WEB_PORT=8080
API_PORT=4000

# Security tuning
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=300

# Time zone for dashboard day buckets
APP_TIMEZONE=Asia/Kolkata

# Demo data: seed on first start (skipped automatically when users already exist)
SEED_ON_START=true
# Optional: override the demo account passwords used by the seed
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_STAFF_PASSWORD=

# Hide the demo-account quick-fill buttons on the login page (true/false)
VITE_SHOW_DEMO_ACCOUNTS=true
