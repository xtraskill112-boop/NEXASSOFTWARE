# Where the browser reaches the API (in production: the Render address, set by the deploy)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Firebase: local development uses the emulators (pnpm emulators). Leave these unset in
# production — the defaults are the naamdevseets project's public web config.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-naamdev
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Optional: Google Maps JavaScript API key (address pin + live tracking map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
