{
  "name": "@naamdev/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "firebase emulators:exec --config ../../firebase.json --project demo-naamdev --only auth,firestore,storage \"vitest run\"",
    "test:inside-emulators": "vitest run"
  },
  "dependencies": {
    "@naamdev/db": "workspace:*",
    "@naamdev/shared": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "file-type": "21.3.4",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "multer": "2.0.2",
    "nodemailer": "7.0.13",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "sharp": "0.34.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.2.0",
    "supertest": "7.1.4",
    "tsup": "8.5.1",
    "tsx": "4.21.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
