# Where the Next.js server reaches the API (server-side fetches and /api rewrites)
API_INTERNAL_URL=http://localhost:4000
# Public URL of this storefront (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-reachable API origin for realtime (Socket.IO)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Optional: Google Maps JavaScript API key (address pin + live tracking map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Firebase web config for push notifications
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
