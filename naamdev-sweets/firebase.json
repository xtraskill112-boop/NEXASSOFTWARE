{
  "hosting": [
    {
      "target": "web",
      "public": "firebase/hosting-public",
      "ignore": [
        "**/.*"
      ],
      "cleanUrls": false,
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "naamdev-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/static/**",
          "run": {
            "serviceId": "naamdev-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "**",
          "run": {
            "serviceId": "naamdev-web",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "target": "admin",
      "public": "firebase/hosting-public",
      "ignore": [
        "**/.*"
      ],
      "cleanUrls": false,
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "naamdev-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/static/**",
          "run": {
            "serviceId": "naamdev-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "**",
          "run": {
            "serviceId": "naamdev-admin",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "target": "partner",
      "public": "firebase/hosting-public",
      "ignore": [
        "**/.*"
      ],
      "cleanUrls": false,
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "naamdev-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/static/**",
          "run": {
            "serviceId": "naamdev-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "**",
          "run": {
            "serviceId": "naamdev-partner",
            "region": "asia-south1"
          }
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
