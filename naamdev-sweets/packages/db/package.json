{
  "name": "@naamdev/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit -p ."
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@naamdev/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "4.21.1",
    "@node-rs/argon2": "2.0.2",
    "typescript": "5.9.3",
    "dotenv": "16.6.1"
  }
}
