// NAAMDEV SWEETS — relational data model
// Money is stored as integer paise (₹1 = 100 paise) to avoid floating point errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETED
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum FoodType {
  VEG
  EGG
  NON_VEG
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PREPARING
  PACKED
  READY_FOR_PICKUP
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_INITIATED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  COD_PENDING
  COD_COLLECTED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTxnStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum RefundMethod {
  GATEWAY
  MANUAL
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum ActorType {
  CUSTOMER
  STAFF
  PARTNER
  SYSTEM
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
}

enum StockTxnType {
  STOCK_IN
  RESERVED
  RELEASED
  SOLD
  ADJUSTMENT
  DAMAGED
  EXPIRED
  RETURNED
}

enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  DISCARDED
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  SCOOTER
  EV_SCOOTER
  CAR
}

enum DocumentType {
  AADHAAR
  PAN
  DRIVING_LICENSE
  VEHICLE_RC
  PROFILE_PHOTO
  BANK_PROOF
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  AT_STORE
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum EarningType {
  DELIVERY_FEE
  INCENTIVE
  TIP
  ADJUSTMENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  PROMOTION
  COUPON
  INVENTORY
  SUPPORT
  ACCOUNT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum DeliveryResult {
  SENT
  FAILED
  SKIPPED
}

enum TicketCategory {
  ORDER
  REFUND
  CANCELLATION
  PAYMENT
  DELIVERY
  PRODUCT_QUALITY
  ACCOUNT
  FEEDBACK
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  SIGNUP_BONUS
  REFERRAL_BONUS
  ADJUSTMENT
  REVERSAL
}

enum ReferralStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum BannerPlacement {
  HERO
  OFFER_STRIP
  PROMO_GRID
}

enum HomeSectionType {
  CATEGORY_GRID
  BESTSELLERS
  POPULAR
  NEW_ARRIVALS
  TRENDING
  RECOMMENDED
  FAVOURITES
  GIFT_HAMPERS
  FESTIVAL_COLLECTION
  RECENTLY_VIEWED
  FREQUENTLY_PURCHASED
  OFFERS
}

enum OtpPurpose {
  LOGIN
  REGISTER
  VERIFY_PHONE
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ───────────────────────────── Identity & access ─────────────────────────────

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  isStaff     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  group       String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String?    @unique
  phone             String?    @unique
  passwordHash      String?
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  status            UserStatus @default(ACTIVE)
  roleId            String
  role              Role       @relation(fields: [roleId], references: [id])
  avatarUrl         String?
  preferredLanguage String     @default("en")
  referralCode      String     @unique
  referredById      String?
  referredBy        User?      @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers     User[]     @relation("UserReferrals")
  loyaltyPoints     Int        @default(0)
  lifetimePoints    Int        @default(0)
  lastLoginAt       DateTime?
  deletionRequestedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  profile             UserProfile?
  sessions            Session[]
  addresses           Address[]
  cart                Cart?
  wishlist            WishlistItem[]
  productViews        ProductView[]
  orders              Order[]
  reviews             Review[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  tickets             SupportTicket[]          @relation("TicketCustomer")
  assignedTickets     SupportTicket[]          @relation("TicketAssignee")
  ticketMessages      TicketMessage[]
  loyaltyTransactions LoyaltyTransaction[]
  referralsMade       Referral[]               @relation("Referrer")
  referralReceived    Referral?                @relation("Referee")
  couponUsages        CouponUsage[]
  staffProfile        StaffProfile?
  deliveryPartner     DeliveryPartner?
  auditLogs           AuditLog[]
  orderNotes          OrderNote[]
  statusChanges       OrderStatusHistory[]
  returnRequests      ReturnRequest[]
  refundsInitiated    Refund[]
  stockTransactions   StockTransaction[]
  purchases           Purchase[]

  @@index([roleId])
  @@index([createdAt])
}

model UserProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth    DateTime?
  anniversary    DateTime?
  gender         String?
  marketingOptIn Boolean   @default(true)
  smsOptIn       Boolean   @default(true)
  emailOptIn     Boolean   @default(true)
  pushOptIn      Boolean   @default(true)
  updatedAt      DateTime  @updatedAt
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  app        String    @default("web")
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  target     String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([target, purpose, createdAt])
}

model StaffProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String   @unique
  designation  String
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Store {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  addressLine String
  city        String
  state       String
  pincode     String
  lat         Float
  lng         Float
  phone       String
  email       String?
  openingTime String         @default("08:00")
  closingTime String         @default("22:00")
  isActive    Boolean        @default(true)
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  staff       StaffProfile[]
  orders      Order[]
}

model Address {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AddressType @default(HOME)
  label        String?
  fullName     String
  phone        String
  line1        String
  line2        String?
  landmark     String?
  city         String
  state        String
  pincode      String
  lat          Float?
  lng          Float?
  instructions String?
  isDefault    Boolean     @default(false)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  pincode         String   @unique
  area            String
  city            String
  deliveryFeePaise Int?
  etaMinutes      Int      @default(45)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  nameHi      String?
  slug        String     @unique
  description String?
  imageUrl    String?
  accentColor String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  gstRate     Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products        Product[]  @relation("ProductCategory")
  subProducts     Product[]  @relation("ProductSubcategory")
  coupons         Coupon[]   @relation("CouponCategories")
  homeSections    HomeSection[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id                  String    @id @default(cuid())
  name                String
  nameHi              String?
  slug                String    @unique
  shortDescription    String
  shortDescriptionHi  String?
  description         String
  categoryId          String
  category            Category  @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategoryId       String?
  subcategory         Category? @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  sku                 String    @unique
  barcode             String?
  hsnCode             String?
  ingredients         String
  allergens           String[]  @default([])
  nutrition           Json?
  manufacturingInfo   String?
  shelfLifeDays       Int
  storageInstructions String
  foodType            FoodType  @default(VEG)
  isFeatured          Boolean   @default(false)
  isBestseller        Boolean   @default(false)
  isNewArrival        Boolean   @default(false)
  isActive            Boolean   @default(true)
  tags                String[]  @default([])
  videoUrl            String?
  gstRate             Float?
  avgRating           Float     @default(0)
  reviewCount         Int       @default(0)
  soldCount           Int       @default(0)
  viewCount           Int       @default(0)
  seoTitle            String?
  seoDescription      String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  views        ProductView[]
  coupons      Coupon[]            @relation("CouponProducts")
  collections  CollectionProduct[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([isActive, isBestseller])
  @@index([isActive, isNewArrival])
  @@index([isActive, isFeatured])
  @@index([soldCount])
  @@index([avgRating])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  publicId  String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String
  weightGrams    Int?
  sku            String   @unique
  barcode        String?
  mrpPaise       Int
  salePricePaise Int?
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventory         Inventory?
  batches           InventoryBatch[]
  stockTransactions StockTransaction[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  purchaseItems     PurchaseItem[]

  @@index([productId])
}

model Collection {
  id             String              @id @default(cuid())
  name           String
  nameHi         String?
  slug           String              @unique
  description    String?
  bannerImageUrl String?
  theme          String              @default("saffron")
  isFestival     Boolean             @default(false)
  isActive       Boolean             @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  products       CollectionProduct[]
  homeSections   HomeSection[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

// ───────────────────────────── Inventory ─────────────────────────────

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  available         Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(10)
  lastRestockedAt   DateTime?
  lowStockAlertedAt DateTime?
  updatedAt         DateTime       @updatedAt

  @@index([available])
}

model Supplier {
  id            String           @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstin         String?
  address       String?
  notes         String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  batches       InventoryBatch[]
  purchases     Purchase[]
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber  String?
  purchasedAt    DateTime       @default(now())
  totalPaise     Int            @default(0)
  notes          String?
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  items          PurchaseItem[]
}

model PurchaseItem {
  id             String          @id @default(cuid())
  purchaseId     String
  purchase       Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  quantity       Int
  costPricePaise Int
  batchId        String?         @unique
  batch          InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model InventoryBatch {
  id             String                @id @default(cuid())
  variantId      String
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchNumber    String
  supplierId     String?
  supplier       Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  manufacturedAt DateTime
  expiresAt      DateTime
  quantity       Int
  remaining      Int
  costPricePaise Int                   @default(0)
  status         BatchStatus           @default(ACTIVE)
  expiryAlertedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  purchaseItem   PurchaseItem?
  allocations    OrderItemAllocation[]
  transactions   StockTransaction[]

  @@unique([variantId, batchNumber])
  @@index([variantId, status, expiresAt])
  @@index([expiresAt])
}

model StockTransaction {
  id           String          @id @default(cuid())
  variantId    String
  variant      ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchId      String?
  batch        InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type         StockTxnType
  quantity     Int
  balanceAfter Int
  reason       String?
  orderId      String?
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
}

// ───────────────────────────── Cart & wishlist ─────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id            String         @id @default(cuid())
  cartId        String
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity      Int
  savedForLater Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ProductView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

model SearchQuery {
  id             String   @id @default(cuid())
  term           String   @unique
  count          Int      @default(1)
  resultCount    Int      @default(0)
  lastSearchedAt DateTime @default(now())

  @@index([count])
}

// ───────────────────────────── Orders & payments ─────────────────────────────

model Order {
  id                   String             @id @default(cuid())
  orderNumber          String             @unique
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  storeId              String?
  store                Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  status               OrderStatus        @default(PENDING)
  paymentMethod        PaymentMethod
  paymentStatus        OrderPaymentStatus @default(PENDING)
  mrpTotalPaise        Int
  subtotalPaise        Int
  itemDiscountPaise    Int                @default(0)
  couponDiscountPaise  Int                @default(0)
  loyaltyDiscountPaise Int                @default(0)
  deliveryFeePaise     Int                @default(0)
  taxPaise             Int                @default(0)
  totalPaise           Int
  refundedPaise        Int                @default(0)
  couponId             String?
  coupon               Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode           String?
  pointsRedeemed       Int                @default(0)
  pointsEarned         Int                @default(0)
  addressSnapshot      Json
  customerName         String
  customerPhone        String
  customerEmail        String?
  deliveryPincode      String
  deliveryLat          Float?
  deliveryLng          Float?
  deliveryInstructions String?
  customerNote         String?
  deliveryOtp          String?
  estimatedDeliveryAt  DateTime?
  reservationExpiresAt DateTime?
  idempotencyKey       String
  invoiceNumber        String?            @unique
  cancelReason         String?
  cancelledBy          ActorType?
  placedAt             DateTime           @default(now())
  confirmedAt          DateTime?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  notes          OrderNote[]
  payments       Payment[]
  refunds        Refund[]
  returnRequests ReturnRequest[]
  assignments    DeliveryAssignment[]
  trackingPoints TrackingPoint[]
  couponUsage    CouponUsage?
  tickets        SupportTicket[]
  reviews        Review[]
  loyaltyTxns    LoyaltyTransaction[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id             String                @id @default(cuid())
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product               @relation(fields: [productId], references: [id])
  variantId      String
  variant        ProductVariant        @relation(fields: [variantId], references: [id])
  productName    String
  variantLabel   String
  sku            String
  imageUrl       String?
  unitMrpPaise   Int
  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int
  discountPaise  Int                   @default(0)
  gstRate        Float
  taxPaise       Int                   @default(0)
  allocations    OrderItemAllocation[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderItemAllocation {
  id          String         @id @default(cuid())
  orderItemId String
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batchId     String
  batch       InventoryBatch @relation(fields: [batchId], references: [id])
  quantity    Int
  releasedAt  DateTime?

  @@index([orderItemId])
  @@index([batchId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  actorType   ActorType
  changedById String?
  changedBy   User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id               String           @id @default(cuid())
  orderId          String
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method           PaymentMethod
  provider         String
  status           PaymentTxnStatus @default(CREATED)
  amountPaise      Int
  currency         String           @default("INR")
  gatewayOrderId   String?          @unique
  gatewayPaymentId String?          @unique
  methodDetail     String?
  failureReason    String?
  raw              Json?
  capturedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  refunds          Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId       String?
  payment         Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amountPaise     Int
  reason          String
  status          RefundStatus @default(PENDING)
  method          RefundMethod
  gatewayRefundId String?      @unique
  reference       String?
  failureReason   String?
  initiatedById   String?
  initiatedBy     User?        @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  returnRequest   ReturnRequest?

  @@index([orderId])
  @@index([status])
}

model ReturnRequest {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  reason         String
  description    String?
  images         String[]     @default([])
  status         ReturnStatus @default(REQUESTED)
  resolutionNote String?
  refundId       String?      @unique
  refund         Refund?      @relation(fields: [refundId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

// ───────────────────────────── Coupons ─────────────────────────────

model Coupon {
  id               String        @id @default(cuid())
  code             String        @unique
  title            String
  description      String?
  type             CouponType
  scope            CouponScope   @default(ALL)
  value            Int
  maxDiscountPaise Int?
  minOrderPaise    Int           @default(0)
  startsAt         DateTime
  endsAt           DateTime
  usageLimit       Int?
  perUserLimit     Int           @default(1)
  usedCount        Int           @default(0)
  firstOrderOnly   Boolean       @default(false)
  isFestival       Boolean       @default(false)
  isPublic         Boolean       @default(true)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  products         Product[]     @relation("CouponProducts")
  categories       Category[]    @relation("CouponCategories")
  usages           CouponUsage[]
  orders           Order[]

  @@index([isActive, endsAt])
}

model CouponUsage {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountPaise Int
  createdAt     DateTime @default(now())

  @@index([couponId, userId])
}

// ───────────────────────────── Delivery ─────────────────────────────

model DeliveryPartner {
  id                   String        @id @default(cuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               PartnerStatus @default(PENDING)
  vehicleType          VehicleType
  vehicleNumber        String?
  licenseNumber        String?
  city                 String
  isOnline             Boolean       @default(false)
  currentLat           Float?
  currentLng           Float?
  lastLocationAt       DateTime?
  rating               Float         @default(5)
  totalDeliveries      Int           @default(0)
  bankAccountName      String?
  bankAccountEncrypted String?
  bankAccountLast4     String?
  bankIfsc             String?
  upiId                String?
  emergencyContact     String?
  approvedAt           DateTime?
  approvedById         String?
  statusReason         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  documents      PartnerDocument[]
  assignments    DeliveryAssignment[]
  earnings       PartnerEarning[]
  trackingPoints TrackingPoint[]

  @@index([status, isOnline])
}

model PartnerDocument {
  id              String          @id @default(cuid())
  partnerId       String
  partner         DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type            DocumentType
  storageKey      String
  mimeType        String
  status          DocumentStatus  @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime        @default(now())
  reviewedAt      DateTime?

  @@unique([partnerId, type])
}

model DeliveryAssignment {
  id              String           @id @default(cuid())
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId       String
  partner         DeliveryPartner  @relation(fields: [partnerId], references: [id])
  status          AssignmentStatus @default(OFFERED)
  distanceKm      Float?
  earningPaise    Int              @default(0)
  offeredAt       DateTime         @default(now())
  offerExpiresAt  DateTime?
  respondedAt     DateTime?
  arrivedAtStoreAt DateTime?
  pickedUpAt      DateTime?
  outForDeliveryAt DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  earning         PartnerEarning?
  trackingPoints  TrackingPoint[]

  @@index([partnerId, status])
  @@index([orderId, status])
}

model TrackingPoint {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  partnerId    String
  partner      DeliveryPartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  heading      Float?
  speed        Float?
  accuracy     Float?
  recordedAt   DateTime           @default(now())

  @@index([orderId, recordedAt])
}

model PartnerEarning {
  id           String              @id @default(cuid())
  partnerId    String
  partner      DeliveryPartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  assignmentId String?             @unique
  assignment   DeliveryAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  type         EarningType
  amountPaise  Int
  description  String
  isSettled    Boolean             @default(false)
  settledAt    DateTime?
  createdAt    DateTime            @default(now())

  @@index([partnerId, createdAt])
}

// ───────────────────────────── Engagement ─────────────────────────────

model Review {
  id              String       @id @default(cuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating          Int
  title           String?
  body            String?
  status          ReviewStatus @default(PENDING)
  moderatedById   String?
  moderatedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  userId            String?
  channel           NotificationChannel
  template          String
  recipient         String
  status            DeliveryResult
  provider          String
  providerMessageId String?
  error             String?
  createdAt         DateTime            @default(now())

  @@index([createdAt])
  @@index([userId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("web")
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

model SupportTicket {
  id             String          @id @default(cuid())
  ticketNumber   String          @unique
  userId         String?
  user           User?           @relation("TicketCustomer", fields: [userId], references: [id], onDelete: SetNull)
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category       TicketCategory
  priority       TicketPriority  @default(MEDIUM)
  status         TicketStatus    @default(OPEN)
  subject        String
  assignedToId   String?
  assignedTo     User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastActivityAt DateTime        @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       TicketMessage[]

  @@index([userId])
  @@index([status, priority])
  @@index([assignedToId])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorType ActorType
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Faq {
  id         String   @id @default(cuid())
  question   String
  answer     String
  questionHi String?
  answerHi   String?
  category   String   @default("General")
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LoyaltyTransaction {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         LoyaltyTxnType
  points       Int
  balanceAfter Int
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  description  String
  createdAt    DateTime       @default(now())

  @@index([userId, createdAt])
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referrer     User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId    String         @unique
  referee      User           @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  code         String
  status       ReferralStatus @default(PENDING)
  rewardPoints Int            @default(0)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())

  @@index([referrerId])
}

// ───────────────────────────── CMS & settings ─────────────────────────────

model Banner {
  id             String          @id @default(cuid())
  title          String
  titleHi        String?
  subtitle       String?
  eyebrow        String?
  imageUrl       String?
  ctaLabel       String?
  ctaLink        String?
  theme          String          @default("saffron")
  placement      BannerPlacement @default(HERO)
  sortOrder      Int             @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

model HomeSection {
  id           String          @id @default(cuid())
  type         HomeSectionType
  title        String
  titleHi      String?
  subtitle     String?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  limit        Int             @default(10)
  collectionId String?
  collection   Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive, sortOrder])
}

model ContentPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  titleHi        String?
  body           String
  bodyHi         String?
  seoDescription String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Counter {
  key   String @id
  value Int    @default(0)
}
