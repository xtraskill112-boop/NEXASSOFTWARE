# ── Domains (DNS A/AAAA records must point at this server) ──
WEB_DOMAIN=naamdevsweets.com
ADMIN_DOMAIN=admin.naamdevsweets.com
PARTNER_DOMAIN=partner.naamdevsweets.com
API_DOMAIN=api.naamdevsweets.com
ACME_EMAIL=ops@naamdevsweets.com

# ── Database ──
POSTGRES_PASSWORD=change-me-to-a-long-random-string
BACKUP_RETENTION_DAYS=14

# ── Secrets (generate: openssl rand -base64 48 / openssl rand -hex 32) ──
JWT_SECRET=
ENCRYPTION_KEY=
OTP_DEV_ECHO=false
LOG_LEVEL=info
JOBS_ENABLED=true

# ── First super admin (created by the seed; change the password after first login) ──
SEED_ADMIN_EMAIL=owner@naamdevsweets.com
SEED_ADMIN_PHONE=+91XXXXXXXXXX
SEED_ADMIN_PASSWORD=
SEED_DEMO_ACCOUNTS=false

# ── Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudinary (optional) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) ──
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NAAMDEV SWEETS <no-reply@naamdevsweets.com>"

# ── SMS / OTP (MSG91 recommended for India; templates must be DLT-registered) ──
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_FLOW_TEMPLATE_ID=

# ── Firebase Cloud Messaging ──
FIREBASE_SERVICE_ACCOUNT_BASE64=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Google Maps (optional) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SUPPORT_PHONE=
