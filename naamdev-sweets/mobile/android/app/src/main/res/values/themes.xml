<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light base; values-night swaps the parent so pages see prefers-color-scheme: dark. -->
    <style name="Theme.Naamdev.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/shell_bar</item>
        <item name="android:colorAccent">@color/saffron</item>
        <item name="android:statusBarColor">@color/shell_bar</item>
        <item name="android:navigationBarColor">@color/shell_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="Theme.Naamdev" parent="Theme.Naamdev.Base" />
</resources>
