# ---------------------------------------------------------------------------
# StockSense API - local development configuration
# Copy to backend/.env and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://stocksense:change_me@localhost:5432/stocksense?schema=public

# JWT signing secret - at least 32 random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Security tuning
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
TRUST_PROXY=false

# Time zone used for dashboard day buckets
APP_TIMEZONE=Asia/Kolkata

# Optional: demo seed passwords (defaults documented in README)
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_STAFF_PASSWORD=
