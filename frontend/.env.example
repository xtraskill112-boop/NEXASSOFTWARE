# Frontend (Vite) - optional overrides for local development
# API base URL used by the browser. Default "/api" (proxied by the Vite dev server / nginx).
# VITE_API_URL=/api
# Where the Vite dev server proxies /api requests.
# VITE_DEV_API_PROXY=http://localhost:4000
# Show demo-account quick-fill buttons on the login page (true/false).
VITE_SHOW_DEMO_ACCOUNTS=true
